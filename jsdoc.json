{
    "source": {
        "include": [
            "src/"
        ],
        "includePattern": ".+\\.(jsx|js)$"
    },
    "opts": {
        "destination": "docs",
        "recurse": true
    },
    "plugins": [
        "plugins/markdown"
    ],
    "templates": {
        "cleverLinks": true,
        "monospaceLinks": true
    }
}